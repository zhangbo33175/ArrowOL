.scroll-root {
    background-color: #252526;
}

.root {
    padding: 10px;
    flex-direction: column;
}

.lang-type-label {
    color: #ccc;
    font-size: 12px;
    margin-bottom: 6px;
}

.full-btn {
    height: 26px;
    margin-bottom: 8px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #3c3c3c;
    color: #e8e8e8;
    font-size: 11px;
}

.full-btn:hover { background-color: #4c4c4c; }

.section {
    background-color: #2d2d30;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
}

.section-title {
    color: #569cd6;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.row {
    flex-direction: row;
    margin-bottom: 6px;
}

.row > Button {
    flex-grow: 1;
    margin-right: 5px;
    height: 26px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #3c3c3c;
    color: #e8e8e8;
    font-size: 11px;
}

.row > Button:hover { background-color: #4c4c4c; }
.row > Button:last-child { margin-right: 0; }
.primary-btn { background-color: #2d6fb5; border-color: #3a82cc; color: white; }
.primary-btn:hover { background-color: #3a82cc; }

.section > Toggle {
    margin-bottom: 4px;
    font-size: 11px;
}

.tmp-toggle {
    margin-top: 4px;
    font-size: 11px;
}

.list-container {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    padding: 6px;
    margin-top: 4px;
}
