/* TableExportEditorWindowTool.uss */

.root {
    padding: 8px;
    background-color: #252526;
    flex-direction: column;
}

/* 顶部统计栏 */
.header-row {
    flex-direction: row;
    background-color: #2d2d30;
    border-radius: 4px;
    padding: 8px 14px;
    margin-bottom: 8px;
    border-left: 3px solid #4a9eff;
}

.stat-label {
    color: #cccccc;
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 28px;
}

/* 按钮行 */
.button-row {
    flex-direction: row;
    width: 100%;
    margin-bottom: 8px;
    height: 30px;
}

.button-row > Button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-right: 6px;
    height: 30px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #3c3c3c;
    color: #e8e8e8;
    font-size: 12px;
    transition: background-color 0.1s;
}

.button-row > Button:hover {
    background-color: #4c4c4c;
    border-color: #555;
}

.button-row > Button:active {
    background-color: #2c2c2c;
}

.button-row > Button:last-child {
    margin-right: 0;
}

.primary-btn {
    background-color: #2d6fb5;
    border-color: #3a82cc;
    color: white;
}

.primary-btn:hover {
    background-color: #3a82cc;
}

.primary-btn:active {
    background-color: #245890;
}

/* 搜索栏 */
.search-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.search-field {
    flex-grow: 1;
    flex-basis: 10px;
}

.search-field > Label {
    min-width: 40px;
    font-size: 12px;
    color: #999;
}

.clear-btn {
    width: 28px;
    height: 24px;
    margin-left: 6px;
    background-color: #3c3c3c;
    color: #999;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
}

.clear-btn:hover {
    background-color: #4c4c4c;
    color: #ccc;
}

/* 目录树容器 */
.tree-container {
    height: 240px;
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 8px;
}

/* 自定义导出区 */
.custom-section {
    border-top: 1px solid #3c3c3c;
    padding-top: 10px;
    flex-shrink: 0;
}

.section-title {
    color: #569cd6;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.custom-path-label {
    color: #777;
    font-size: 11px;
    padding: 6px 10px;
    background-color: #2d2d30;
    border-radius: 3px;
    margin-bottom: 6px;
    white-space: nowrap;
}

.custom-section > Button {
    width: 100%;
    height: 30px;
    margin-bottom: 6px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #3c3c3c;
    color: #e8e8e8;
    font-size: 12px;
}

.custom-section > Button:hover {
    background-color: #4c4c4c;
}

.custom-section > .button-row {
    margin-bottom: 6px;
}
