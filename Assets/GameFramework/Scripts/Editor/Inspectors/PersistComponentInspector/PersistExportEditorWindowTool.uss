.root {
    padding: 10px;
    background-color: #252526;
    flex-direction: column;
}

.section {
    background-color: #2d2d30;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 8px;
}

.section-title {
    color: #569cd6;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.row {
    flex-direction: row;
}

.row > Button {
    flex-grow: 1;
    margin-right: 5px;
    height: 30px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #3c3c3c;
    color: #e8e8e8;
    font-size: 11px;
}

.row > Button:hover { background-color: #4c4c4c; }
.row > Button:last-child { margin-right: 0; }
.primary-btn { background-color: #2d6fb5; border-color: #3a82cc; color: white; }
.primary-btn:hover { background-color: #3a82cc; }

.debug-section {
    flex-grow: 1;
}

.debug-scroll {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
}

.debug-container {
    padding: 4px;
}
