.root-container {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(38, 38, 38);
}

.left-panel {
    width: 170px;
    flex-grow: 0;
    flex-direction: column;
    background-color: rgb(45, 45, 48);
}

.left-btn-row {
    flex-direction: row;
    height: 30px;
    padding: 2px;
}

.left-btn {
    flex-grow: 1;
    height: 26px;
    margin: 2px;
    background-color: rgb(60, 60, 60);
    color: rgb(255, 255, 255);
}

.left-btn:hover {
    background-color: rgb(70, 70, 70);
}

.left-btn:active {
    background-color: rgb(50, 50, 50);
}

.chapter-box {
    flex-grow: 1;
    margin: 4px;
    background-color: rgb(45, 45, 48);
    border: 1px solid rgb(60, 60, 63);
}

.chapter-list {
    flex-grow: 1;
}

.chapter-item {
    flex-direction: column;
    margin-bottom: 1px;
    background-color: rgb(50, 50, 53);
}

.chapter-item:hover {
    background-color: rgb(65, 65, 65);
}

.chapter-header {
    flex-direction: row;
    height: 28px;
    padding: 0 8px;
    align-items: center;
    background-color: rgb(55, 55, 58);
    border-bottom: 1px solid rgb(65, 65, 68);
}

.chapter-header:hover {
    background-color: rgb(65, 65, 68);
}

.chapter-title {
    flex-grow: 1;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    -unity-text-align: middle-left;
    margin-left: 4px;
}

.expand-arrow {
    width: 16px;
    font-size: 9px;
    color: rgb(140, 140, 140);
    -unity-text-align: middle-center;
}

.level-container {
    flex-direction: column;
    padding: 2px 0;
}

.level-item {
    height: 24px;
    padding: 0 8px 0 28px;
    font-size: 11px;
    color: rgb(190, 190, 190);
    -unity-text-align: middle-left;
}

.level-item:hover {
    background-color: rgb(65, 65, 70);
    color: rgb(255, 255, 255);
}

.level-item.selected {
    background-color: rgb(20, 100, 160);
    color: rgb(255, 255, 255);
}

.sub-tab-btn {
    width: 42px;
    height: 24px;
    margin: 1px;
    background-color: rgb(60, 60, 60);
    color: rgb(255, 255, 255);
}

.sub-tab-btn:hover {
    background-color: rgb(70, 70, 70);
}

.sub-tab-btn.active {
    background-color: rgb(14, 99, 156);
}

.resource-list {
    flex-grow: 1;
    background-color: rgb(55, 55, 55);
    margin: 4px;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    margin-bottom: 2px;
    background-color: rgb(60, 60, 60);
}

.resource-item:hover {
    background-color: rgb(70, 70, 70);
}

.resource-icon {
    width: 32px;
    height: 32px;
    margin-right: 6px;
    background-color: rgb(80, 80, 80);
}

.resource-name {
    font-size: 12px;
    color: rgb(255, 255, 255);
}

.sub-tab-btn.active {
    background-color: rgb(14, 99, 156);
}

.refresh-btn {
    width: 40px;
    height: 22px;
    margin: 1px;
    margin-left: auto;
    background-color: rgb(45, 45, 48);
    color: rgb(255, 255, 255);
}

.resource-list {
    flex-grow: 1;
}

.resource-item {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 2px 4px;
    padding: 3px 6px;
    background-color: rgb(55, 55, 55);
    border-radius: 3px;
}

.resource-item:hover {
    background-color: rgb(70, 70, 70);
}

.resource-item.selected {
    background-color: rgb(35, 70, 110);
}

.resource-icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    border-radius: 3px;
    background-color: rgb(45, 45, 45);
    object-fit: scale-down;
    overflow: hidden;
    flex-shrink: 0;
}

.resource-name {
    flex-grow: 1;
    font-size: 12px;
    color: rgb(230, 230, 230);
}

.separator-v {
    width: 1px;
    background-color: rgb(66, 66, 66);
}

.right-main-area {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    overflow: hidden;
}

.top-toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    height: 30px;
    min-height: 30px;
    max-height: 30px;
    flex-direction: row;
    background-color: rgb(51, 51, 51);
}

.toolbar-row {
    flex-direction: row;
    height: 26px;
}

.tab-btn {
    width: 80px;
    height: 22px;
    margin-right: 2px;
    background-color: rgb(45, 45, 48);
    color: rgb(255, 255, 255);
}

.tab-btn.active {
    background-color: rgb(14, 99, 156);
}

.sub-tab-btn {
    background-color: rgb(50, 50, 55);
    color: rgb(200, 200, 200);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(70, 70, 75);
}

.sub-tab-btn.active {
    background-color: rgb(14, 99, 156);
    color: white;
}

.tool-btn {
    height: 24px;
    margin-right: 6px;
    background-color: rgb(60, 60, 65);
    color: rgb(230, 230, 230);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(80, 80, 85);
    padding: 0 10px;
    font-size: 12px;
}

.tool-btn:hover {
    background-color: rgb(75, 75, 80);
    border-color: rgb(100, 100, 105);
}

.tool-btn:active {
    background-color: rgb(50, 50, 55);
}

.tool-btn.danger-btn {
    background-color: rgb(160, 60, 60);
    border-color: rgb(180, 80, 80);
    color: rgb(255, 255, 255);
}

.tool-btn.danger-btn:hover {
    background-color: rgb(180, 70, 70);
}

.flex-space {
    flex-grow: 1;
}

.mode-panel {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
}

.mode-panel.hidden {
    display: none;
}

.scene-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    background-color: rgb(178, 153, 153);
}

.status-bar {
    height: 26px;
    background-color: rgb(37, 37, 38);
    color: rgb(255, 255, 255);
    padding: 4px 8px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
}

.status-label {
    font-size: 12px;
    unity-text-alignment: middle-left;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.status-value {
    font-size: 12px;
    unity-text-alignment: middle-left;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.status-label {
    color: rgb(180, 180, 180);
}

.status-value {
    color: rgb(255, 255, 255);
}

.status-value-fixed {
    color: rgb(255, 255, 255);
    min-width: 40px;
    max-width: 40px;
    unity-text-alignment: middle-left;
}

.status-grid-size {
    color: rgb(255, 255, 255);
    min-width: 56px;
    max-width: 56px;
    unity-text-alignment: middle-left;
}

.status-path-btn {
    font-size: 12px;
    background-color: transparent;
    color: rgb(255, 255, 255);
    border-width: 0;
    padding: 0;
    margin-left: 4px;
}

.status-path-btn:hover {
    background-color: rgb(50, 50, 50);
}

.bottom-props-area {
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
    padding: 6px;
    background-color: rgb(45, 45, 48);
}

.prop-box {
    background-color: rgb(55, 55, 55);
    padding: 8px;
    margin-right: 8px;
}

.prop-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.small-btn {
    width: 70px;
    height: 24px;
    margin-right: 6px;
    background-color: rgb(45, 45, 48);
    color: rgb(255, 255, 255);
}

.small-textfield {
    width: 60px;
    margin-right: 10px;
}

.prop-table-box {
    margin-left: 6px;
}

.table-row {
    flex-direction: row;
    background-color: rgb(56, 56, 56);
    margin-bottom: 1px;
}

.table-header {
    background-color: rgb(64, 64, 64);
}

.table-col {
    width: 60px;
    padding: 3px;
    color: rgb(255, 255, 255);
}

.table-textfield {
    flex-grow: 1;
    margin: 0;
}

.detail-box {
    margin-left: 6px;
}

.detail-row {
    flex-direction: row;
    align-items: center;
    spacing: 8px;
    min-height: 24px;
    margin-bottom: 6px;
}

.detail-label {
    width: 50px;
    color: rgb(200, 200, 200);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.detail-value {
    margin-right: 15px;
    color: rgb(235, 235, 235);
    font-size: 12px;
}

.detail-textfield {
    height: 22px;
    background-color: rgb(60, 60, 63);
    border: 1px solid rgb(80, 80, 83);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.detail-textfield:focus {
    border-color: rgb(100, 180, 255);
}

.publish-btn {
    width: 70px;
    height: 50px;
    margin-left: 10px;
    background-color: rgb(60, 120, 60);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(80, 150, 80);
    font-size: 13px;
    -unity-font-style: bold;
}

.publish-btn:hover {
    background-color: rgb(70, 140, 70);
}

.publish-btn:active {
    background-color: rgb(50, 100, 50);
}

.shortcut-area {
    margin-top: 10px;
}

.shortcut-text {
    font-size: 11px;
    color: rgb(180, 180, 180);
    margin-bottom: 1px;
}

.item-top-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    background-color: rgb(51, 51, 51);
}

.item-element-container {
    flex-grow: 1;
    flex-direction: row;
    padding: 8px;
}

.item-list-panel {
    width: 320px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 10px;
    background-color: rgb(51, 51, 51);
    padding: 8px;
}

.item-list {
    flex-grow: 1;
}

.item-element-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-bottom: 6px;
    background-color: rgb(55, 55, 55);
    border-radius: 4px;
}

.item-element-item:hover {
    background-color: rgb(70, 70, 70);
}

.item-element-item.selected {
    background-color: rgb(35, 70, 110);
}

.item-icon {
    width: 52px;
    height: 52px;
    margin-right: 12px;
    border-radius: 6px;
    background-color: rgb(45, 45, 45);
    object-fit: scale-down;
    overflow: hidden;
    flex-shrink: 0;
}

.item-text-area {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.item-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
}

.item-desc {
    font-size: 11px;
    color: rgb(180, 180, 180);
}

.item-show-toggle {
    margin-left: auto;
    margin-right: 4px;
}

.item-info {
    flex-grow: 1;
}

.item-properties-panel {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(51, 51, 51);
    padding: 8px;
}

.prop-label {
    width: 80px;
    color: rgb(255, 255, 255);
}

.prop-textfield {
    flex-grow: 1;
}

.mode-btn {
    height: 22px;
    margin-right: 4px;
    background-color: rgb(45, 45, 48);
    color: rgb(255, 255, 255);
}

.mode-btn.active {
    background-color: rgb(14, 99, 156);
}

.fog-top-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    background-color: rgb(51, 51, 51);
}

.fog-container {
    flex-grow: 1;
    flex-direction: row;
    padding: 8px;
}

.fog-settings-panel {
    width: 280px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 10px;
    background-color: rgb(55, 55, 55);
    padding: 10px;
}

.fog-list-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    background-color: rgb(51, 51, 51);
    padding: 10px;
}

.prop-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.group-header {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.group-header .sub-title {
    margin-right: 6px;
}

.group-arrow {
    width: 16px;
    height: 16px;
    background-color: rgb(70, 70, 70);
    border-radius: 3px;
    color: rgb(230, 230, 230);
    font-size: 11px;
    -unity-text-align: middle-center;
}

.prop-label {
    width: 80px;
    color: rgb(255, 255, 255);
}

.prop-slider {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    max-width: 160px;
    margin-left: 10px;
    margin-right: 40px;
}

.draw-mode-btn {
    height: 28px;
    margin-top: 8px;
    margin-bottom: 8px;
    background-color: rgb(45, 45, 48);
    color: rgb(255, 255, 255);
}

.shortcut-text {
    font-size: 11px;
    color: rgb(180, 180, 180);
    margin-bottom: 2px;
}

.empty-tip {
    font-size: 12px;
    color: rgb(150, 150, 150);
    margin-top: 4px;
}

.object-edit-panel {
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    background-color: rgb(50, 50, 55);
    border-width: 1px;
    border-color: rgb(70, 70, 75);
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
}

.obj-edit-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 200, 100);
    margin-bottom: 4px;
    white-space: nowrap;
    -unity-text-overflow: ellipsis;
    overflow: hidden;
    flex-grow: 0;
    flex-shrink: 0;
}

.obj-edit-tab-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.obj-tab-btn {
    height: 24px;
    margin-right: 6px;
    background-color: rgb(60, 60, 65);
    color: rgb(230, 230, 230);
    flex-shrink: 0;
    white-space: nowrap;
    padding: 0 12px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(80, 80, 85);
    font-size: 12px;
}

.obj-tab-btn:hover {
    background-color: rgb(75, 75, 80);
}

.obj-tab-btn.active {
    background-color: rgb(14, 99, 156);
    border-color: rgb(30, 120, 180);
    color: rgb(255, 255, 255);
}

.obj-clear-btn {
    height: 24px;
    width: 80px;
    background-color: rgb(100, 60, 60);
    color: rgb(255, 230, 230);
    flex-shrink: 0;
    white-space: nowrap;
    padding: 0 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(120, 80, 80);
    font-size: 12px;
}

.obj-clear-btn:hover {
    background-color: rgb(120, 70, 70);
}

.obj-edit-content {
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
}

.obj-edit-content.hidden {
    display: none;
}

.obj-edit-info-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 3px;
    white-space: nowrap;
}

.obj-edit-btn-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 3px;
}

.obj-edit-btn-row .tool-btn {
    flex-shrink: 0;
    white-space: nowrap;
    padding: 0 6px;
    margin-right: 4px;
}

.path-point-list {
    max-height: 110px;
    margin-top: 2px;
}

.path-point-item {
    flex-direction: row;
    align-items: center;
    padding: 1px 4px;
    margin-bottom: 1px;
    background-color: rgb(64, 64, 64);
}

.path-point-item:hover {
    background-color: rgb(74, 74, 74);
}

.path-point-item.selected {
    background-color: rgb(14, 99, 156);
}

.path-point-index {
    width: 28px;
    color: rgb(180, 180, 180);
    font-size: 11px;
}

.path-point-pos {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 11px;
}

.path-point-del {
    width: 20px;
    height: 18px;
    font-size: 10px;
    margin: 0;
    background-color: rgb(80, 60, 60);
    color: rgb(255, 255, 255);
}

.bottom-props-area {
    background-color: rgb(45, 45, 48);
    border-top: 1px solid rgb(60, 60, 60);
}

.prop-box {
    background-color: rgb(49, 49, 53);
    border: 1px solid rgb(72, 72, 78);
    border-radius: 5px;
}

.box-title {
    color: rgb(100, 180, 255);
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom: 1px solid rgb(70, 70, 73);
}

.prop-label {
    color: rgb(200, 200, 200);
    font-size: 12px;
    -unity-text-align: middle-right;
}

.prop-textfield {
    background-color: rgb(60, 60, 63);
    border: 1px solid rgb(80, 80, 83);
    color: rgb(255, 255, 255);
}

.prop-textfield.readonly {
    background-color: rgb(48, 48, 50);
    border-color: rgb(66, 66, 69);
    color: rgb(170, 170, 170);
}

.small-textfield {
    background-color: rgb(60, 60, 63);
    border: 1px solid rgb(80, 80, 83);
    color: rgb(255, 255, 255);
}

.prop-textfield:focus {
    border-color: rgb(100, 180, 255);
}

.small-textfield:focus {
    border-color: rgb(100, 180, 255);
}

.small-btn {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
    background-color: rgb(70, 70, 73);
    color: rgb(255, 255, 255);
    border: 1px solid rgb(90, 90, 93);
}

.small-btn:hover {
    background-color: rgb(80, 80, 83);
}

.prop-action-row {
    flex-direction: row;
    align-items: center;
    spacing: 6px;
    min-height: 26px;
}

.prop-action-label {
    width: 34px;
    flex-shrink: 0;
    color: rgb(190, 190, 195);
    font-size: 12px;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.prop-action-btn {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 30px;
    height: 26px;
    margin: 0;
    padding: 0 3px;
    font-size: 11px;
    background-color: rgb(58, 58, 62);
    color: rgb(235, 235, 235);
    border: 1px solid rgb(95, 95, 102);
    border-radius: 5px;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.prop-action-btn:hover {
    background-color: rgb(74, 74, 80);
    border-color: rgb(110, 110, 118);
}

.prop-action-btn:active {
    background-color: rgb(48, 48, 52);
}

.prop-action-btn.secondary {
    background-color: rgb(50, 50, 54);
    border-color: rgb(78, 78, 84);
    color: rgb(190, 190, 195);
}

.prop-action-btn.secondary:hover {
    background-color: rgb(62, 62, 67);
    border-color: rgb(92, 92, 98);
}

.prop-action-value {
    width: 42px;
    height: 26px;
    justify-content: center;
    background-color: rgb(45, 45, 49);
    border: 1px solid rgb(80, 80, 85);
    border-radius: 5px;
    color: rgb(235, 235, 235);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.property-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

#property-panel {
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.property-body {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
    spacing: 8px;
}

.property-action-area {
    flex-grow: 0;
    flex-shrink: 1;
    min-height: 0;
    max-height: 300px;
    width: 224px;
    align-self: stretch;
    background-color: rgb(38, 38, 42);
    border: 1px solid rgb(70, 70, 73);
    border-radius: 5px;
    overflow: hidden;
}

.property-action-area .unity-scroll-view-content {
    flex-direction: column;
    justify-content: flex-start;
    spacing: 6px;
    padding: 8px;
}

.property-action-area .unity-scroll-view-horizontal-scroller {
    display: none;
}

.prop-action-host {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    spacing: 6px;
    margin-top: 4px;
    padding: 6px 0;
}

.collectible-action {
    flex-direction: column;
    spacing: 6px;
    flex-shrink: 0;
}

.danger-btn {
    background-color: rgb(140, 60, 60);
    border-color: rgb(160, 70, 70);
}

.danger-btn:hover {
    background-color: rgb(160, 70, 70);
}

.publish-btn {
    height: 22px;
    padding: 0 12px;
    font-size: 11px;
    background-color: rgb(60, 140, 60);
    color: rgb(255, 255, 255);
    border: 1px solid rgb(70, 160, 70);
}

.publish-btn:hover {
    background-color: rgb(70, 160, 70);
}

.obj-tab-btn {
    height: 22px;
    padding: 0 10px;
    font-size: 11px;
    background-color: rgb(60, 60, 63);
    color: rgb(200, 200, 200);
    border: 1px solid rgb(80, 80, 83);
}

.obj-tab-btn.active {
    background-color: rgb(14, 99, 156);
    color: rgb(255, 255, 255);
    border-color: rgb(30, 120, 180);
}

.obj-tab-btn:hover {
    background-color: rgb(70, 70, 73);
}

.obj-tab-btn.active:hover {
    background-color: rgb(30, 120, 180);
}

.obj-clear-btn {
    height: 22px;
    padding: 0 10px;
    font-size: 11px;
    background-color: rgb(120, 70, 70);
    color: rgb(255, 255, 255);
    border: 1px solid rgb(140, 80, 80);
}

.obj-clear-btn:hover {
    background-color: rgb(140, 80, 80);
}

.tool-btn {
    height: 22px;
    padding: 0 8px;
    font-size: 11px;
    background-color: rgb(70, 70, 73);
    color: rgb(255, 255, 255);
    border: 1px solid rgb(90, 90, 93);
}

.element-type-tabs {
    flex-direction: row;
    margin-bottom: 6px;
    background-color: rgb(45, 45, 48);
    border: 1px solid rgb(60, 60, 63);
}

.element-type-tab {
    flex-grow: 1;
    height: 24px;
    margin: 0;
    padding: 0;
    border-radius: 0;
    background-color: rgb(50, 50, 53);
    color: rgb(200, 200, 200);
    border: none;
    border-right: 1px solid rgb(60, 60, 63);
    font-size: 12px;
}

.element-type-tab-last {
    border-right: none;
}

.element-type-tab:hover {
    background-color: rgb(60, 60, 63);
}

.element-type-tab.active {
    background-color: rgb(50, 120, 180);
    color: rgb(255, 255, 255);
}

.tool-btn:hover {
    background-color: rgb(80, 80, 83);
}

.shortcut-text {
    color: rgb(150, 150, 150);
    font-size: 10px;
}

#unconfigured-resources-list Button {
    margin: 2px 0;
    padding: 4px 8px;
    background-color: rgb(60, 60, 63);
    color: rgb(220, 220, 220);
    border-radius: 3px;
}

#unconfigured-resources-list Button:hover {
    background-color: rgb(80, 80, 83);
}

#unconfigured-resources-list Button.selected {
    background-color: rgb(14, 99, 156);
    color: rgb(255, 255, 255);
    border-left: 3px solid rgb(100, 180, 255);
}

.config-table .table-row {
    flex-direction: row;
    align-items: center;
    border-bottom: 1px solid rgb(0, 0, 0);
    border-left: 1px solid rgb(0, 0, 0);
    border-right: 1px solid rgb(0, 0, 0);
}

.config-table .table-cell {
    padding-left: 6px;
    padding-right: 6px;
    border-right: 1px solid rgb(0, 0, 0);
    font-size: 11px;
    color: rgb(0, 0, 0);
}

.config-table .table-cell-textfield {
    background-color: transparent;
    border-top: none;
    border-bottom: none;
    border-left: none;
    border-right: 1px solid rgb(0, 0, 0);
    padding-left: 6px;
    padding-right: 6px;
    font-size: 11px;
    color: rgb(0, 0, 0);
}

.config-table .table-cell-textfield .unity-text-input {
    background-color: transparent;
    border-top: none;
    border-bottom: none;
    border-left: none;
    border-right: none;
    padding-left: 0;
    padding-right: 0;
    color: rgb(0, 0, 0);
}

.config-table .table-cell-toggle {
    padding-left: 6px;
    padding-right: 6px;
    border-right: 1px solid rgb(0, 0, 0);
    font-size: 11px;
    background-color: transparent;
}

.traffic-panel {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    padding: 0;
    margin: 4px 0 0 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 5px;
}

.traffic-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(100, 180, 255);
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgb(70, 70, 73);
    white-space: nowrap;
}

.traffic-toggle-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 26px;
    margin-bottom: 6px;
}

.traffic-toggle-label {
    flex-grow: 0;
    flex-shrink: 0;
    color: rgb(220, 220, 220);
    font-size: 12px;
    margin-right: 6px;
    white-space: nowrap;
}

.traffic-toggle {
    flex-grow: 0;
    flex-shrink: 0;
}

.traffic-field-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 26px;
    margin-bottom: 6px;
}

.traffic-field-label {
    width: 72px;
    flex-shrink: 0;
    color: rgb(200, 200, 200);
    font-size: 12px;
    -unity-text-align: middle-right;
    margin-right: 6px;
    white-space: nowrap;
}

.traffic-input {
    flex-grow: 1;
    flex-shrink: 1;
}

.traffic-input .unity-text-input {
    background-color: rgb(60, 60, 63);
    border: 1px solid rgb(80, 80, 83);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.traffic-input .unity-base-field__input {
    background-color: rgb(60, 60, 63);
    border: 1px solid rgb(80, 80, 83);
    border-radius: 3px;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.traffic-tool-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    spacing: 6px;
    margin-bottom: 8px;
}

.traffic-tool-btn {
    height: 26px;
    min-width: 68px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0 8px;
    font-size: 11px;
    background-color: rgb(58, 58, 62);
    color: rgb(235, 235, 235);
    border: 1px solid rgb(95, 95, 102);
    border-radius: 5px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.traffic-tool-btn:hover {
    background-color: rgb(74, 74, 80);
    border-color: rgb(110, 110, 118);
}

.traffic-tool-btn.active {
    background-color: rgb(14, 99, 156);
    border-color: rgb(30, 120, 180);
    color: rgb(255, 255, 255);
}

.traffic-list {
    max-height: 120px;
    flex-shrink: 0;
    margin-bottom: 6px;
    background-color: transparent;
    border-width: 0;
}

.traffic-validate {
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
}

.traffic-item {
    padding: 4px 6px;
    margin-bottom: 3px;
    background-color: rgb(56, 56, 58);
    border-radius: 3px;
    color: rgb(220, 220, 220);
    font-size: 11px;
    white-space: nowrap;
    -unity-text-overflow: ellipsis;
    overflow: hidden;
}

.traffic-item-empty {
    color: rgb(150, 150, 150);
    font-size: 11px;
    padding: 4px 2px;
}

.traffic-light-bind-list {
    flex-grow: 0;
    flex-shrink: 0;
    max-height: 108px;
    margin: 0 0 6px 78px;
    padding: 2px 0;
    background-color: transparent;
    border-width: 0;
}

.traffic-light-item {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 22px;
    color: rgb(220, 220, 220);
    font-size: 11px;
    white-space: nowrap;
}

.traffic-select-all {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 26px;
    color: rgb(210, 210, 210);
    font-size: 12px;
    font-weight: bold;
    white-space: nowrap;
}
