                            <ui:Button text="取消选中" name="btn-clear-target" class="obj-clear-btn" />
                        </ui:VisualElement>
                        <ui:VisualElement name="path-edit-content" class="obj-edit-content" style="display: flex;">
                            <ui:VisualElement class="obj-edit-btn-row" style="spacing: 4px;">
                                <ui:Button text="停止绘制路径" name="btn-path-draw" class="tool-btn" />
                                <ui:Button text="撤销最后点" name="btn-path-undo" class="tool-btn" />
