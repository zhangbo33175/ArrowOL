                            <ui:Label text="秒" class="prop-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="fog-mode-panel" class="mode-panel hidden" style="display: none;">
                <ui:VisualElement class="fog-top-bar">
                    <ui:Label text="迷雾编辑模式" class="mode-title" />
                    <ui:VisualElement class="flex-space" />
                    <ui:Button text="添加迷雾区域" name="btn-add-fog" class="tool-btn" />
                    <ui:Button text="清空迷雾" name="btn-clear-fog" class="tool-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="fog-container">
                    <ui:VisualElement class="fog-settings-panel">
                        <ui:Label text="笔刷设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="笔刷大小：" class="prop-label" />
                            <ui:Slider low-value="10" high-value="200" value="100" class="prop-slider" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="迷雾透明度：" class="prop-label" />
                            <ui:Slider low-value="0" high-value="1" value="0.8" class="prop-slider" />
                        </ui:VisualElement>
                        <ui:Label text="绘制模式" class="sub-title" />
                        <ui:Button text="开始绘制" name="btn-start-draw" class="draw-mode-btn" />
                        <ui:Label text="快捷键：" class="sub-title" />
                        <ui:Label text="• 鼠标左键：绘制迷雾" class="shortcut-text" />
                        <ui:Label text="• 鼠标右键：擦除迷雾" class="shortcut-text" />
                        <ui:Label text="• 滚轮：缩放地图" name="Label" class="shortcut-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="fog-list-panel">
                        <ui:Label text="迷雾区域列表" class="sub-title" />
                        <ui:Label text="（暂无迷雾区域，点击「添加迷雾区域」或开始绘制）" class="empty-tip" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
