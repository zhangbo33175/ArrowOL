                    <ui:Toggle text="物件层" value="true" name="layer-object" />
                    <ui:Toggle text="背景层" value="true" name="layer-background" />
                    <ui:Toggle text="包围盒" name="layer-bounding-box" />
                </ui:VisualElement>
                <ui:VisualElement name="map-prefab-row" style="flex-direction: row; padding: 4px 8px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75);">
                    <ui:Label text="地图预制体:" style="align-self: center; margin-right: 8px;" />
                </ui:VisualElement>
                <ui:VisualElement class="scene-view" style="margin-left: 4px;" />
                <ui:VisualElement class="status-bar" style="justify-content: flex-start; flex-direction: row; align-self: stretch; align-items: center; padding: 4px 8px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(77, 75, 75); border-right-color: rgb(77, 75, 75); border-top-color: rgb(77, 75, 75); border-bottom-color: rgb(77, 75, 75);">
                    <ui:Label text="缩放率:" class="status-label" />
                    <ui:Label name="status-zoom" text="100%" class="status-value-fixed" />
                    <ui:Label text="mouseX:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-mouse-x" text="0" class="status-value-fixed" />
                    <ui:Label text="mouseY:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-mouse-y" text="0" class="status-value-fixed" style="justify-content: flex-start;" />
                    <ui:Label text="tileX:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-x" text="0" class="status-value-fixed" />
                    <ui:Label text="tileY:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-y" text="0" class="status-value-fixed" />
                    <ui:Label text="格子数:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-count" text="0" class="status-value-fixed" />
                    <ui:Label text="保存路径:" class="status-label" style="margin-left: 16px;" />
                    <ui:Button name="status-save-path" text="Assets/GameData/Maps/" class="status-path-btn" style="width: 740px; flex-direction: row; justify-content: flex-start; -unity-text-align: middle-left; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;" />
                </ui:VisualElement>
                <ui:VisualElement class="bottom-props-area" style="height: 200px; padding: 6px; spacing: 6px; flex-direction: row; align-items: stretch; justify-content: flex-start;">
                    <ui:VisualElement name="VisualElement" class="prop-box" style="width: 398px; padding: 8px; spacing: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;">
                        <ui:VisualElement class="prop-row" style="spacing: 6px; align-items: center;">
                            <ui:Button text="更新地图" class="small-btn" />
                            <ui:Label text="场景名:" class="prop-label" style="width: 44px;" />
                            <ui:TextField value="ChapterN" name="scene-name-field" class="small-textfield flex-grow" />
                            <ui:Label text="宽:" class="prop-label" style="width: 20px;" />
                            <ui:TextField value="2048" name="map-width-field" class="small-textfield" style="width: 50px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row" style="spacing: 6px; align-items: center; height: 21px;">
                            <ui:Button text="导出切片" class="small-btn" />
                            <ui:Label text="场景ID:" class="prop-label" style="width: 44px;" />
                            <ui:TextField value="1" name="scene-id-field" class="small-textfield flex-grow" />
                            <ui:Label text="高:" class="prop-label" style="width: 20px;" />
                            <ui:TextField value="2048" name="map-height-field" class="small-textfield" style="width: 50px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row" style="spacing: 6px; align-items: center;">
                            <ui:Toggle text="DrawClear:" value="true" name="Toggle" />
                            <ui:EnumField style="width: 100px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row" style="spacing: 6px; align-items: center;">
                            <ui:Toggle text="摆放模式:    " value="true" />
                            <ui:EnumField style="width: 100px;" />
                        </ui:VisualElement>
                        <ui:Label text="Ctrl：按住=绘制矩形区域    松开=绘制菱形区域" class="shortcut-text" style="font-size: 10px; margin-top: 4px;" />
                        <ui:Label text="Alt：按住=擦除格子模式   Shift：按住曲线绘制区域" class="shortcut-text" style="font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="object-edit-panel" class="prop-box object-edit-panel" style="width: 389px; padding: 8px; spacing: 4px;">
                        <ui:Label name="obj-edit-title" text="对象编辑：未选择" class="obj-edit-title" style="margin-bottom: 4px; padding-bottom: 2px; border-bottom: 1px solid rgb(70, 70, 73);" />
                        <ui:VisualElement class="obj-edit-tab-row">
                            <ui:Button text="路径信息" name="tab-edit-path" class="obj-tab-btn active" />
                            <ui:Button text="动画信息" name="tab-edit-anim" class="obj-tab-btn" />
                            <ui:VisualElement class="flex-space" />
                            <ui:Button text="取消选中" name="btn-clear-target" class="obj-clear-btn" />
                        </ui:VisualElement>
                        <ui:VisualElement name="path-edit-content" class="obj-edit-content">
                            <ui:VisualElement class="obj-edit-btn-row" style="spacing: 4px;">
                                <ui:Button text="停止绘制路径" name="btn-path-draw" class="tool-btn" />
                                <ui:Button text="撤销最后点" name="btn-path-undo" class="tool-btn" />
                                <ui:Button text="清空路径" name="btn-path-clear" class="tool-btn" />
                            </ui:VisualElement>
                            <ui:Label text="Ctrl+左键 添加路径点（吸附32px网格）" class="shortcut-text" style="font-size: 10px;" />
                            <ui:ScrollView name="path-point-list" class="path-point-list" style="height: 80px;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="anim-edit-content" class="obj-edit-content hidden">
                            <ui:VisualElement class="obj-edit-info-row">
                                <ui:Label text="动画名称：" class="detail-label" />
                                <ui:TextField name="anim-name-field" value="Idle" class="prop-textfield flex-grow" />
                            </ui:VisualElement>
                            <ui:VisualElement class="obj-edit-info-row">
                                <ui:Label text="循环播放：" class="detail-label" />
                                <ui:Toggle name="anim-loop-toggle" text="循环" value="true" />
                                <ui:Label text="速度：" class="detail-label" />
                                <ui:TextField name="anim-speed-field" value="1.0" class="prop-textfield" style="width: 50px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="property-panel" class="prop-box detail-box" style="width: 389px; padding: 8px; spacing: 4px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
                        <ui:Label text="属性" class="box-title" style="margin-bottom: 2px;" />
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="模板ID:" class="detail-label" style="width: 60px;" />
                            <ui:TextField name="prop-template-id" class="detail-textfield flex-grow" style="width: 111px;" />
                            <ui:Label text="tag:" class="detail-label" style="width: 30px;" />
                            <ui:TextField name="prop-tag" class="detail-textfield" style="width: 70px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="格子坐标:" class="detail-label" style="width: 60px;" />
                            <ui:TextField name="prop-grid-pos" class="detail-textfield flex-grow" style="width: 111px;" />
                            <ui:Label text="层级:" class="detail-label" style="width: 30px;" />
                            <ui:TextField name="prop-sort-order" value="0" class="detail-textfield" style="width: 40px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="交互:" class="detail-label" style="width: 60px;" />
                            <ui:VisualElement name="prop-interact-type-container" style="width: 60px;" />
                            <ui:Label text="碰撞:" class="detail-label" style="width: 36px;" />
                            <ui:Toggle name="prop-collision" value="true" />
                            <ui:Label text="阴影:" class="detail-label" style="width: 36px;" />
                            <ui:Toggle name="prop-shadow" value="true" />
                            <ui:Label text="收集:" class="detail-label" style="width: 36px;" />
                            <ui:Toggle name="prop-collectible" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="气泡:" class="detail-label" style="width: 60px;" />
                            <ui:VisualElement name="prop-dialog-bubble-container" class="flex-grow" style="width: 111px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="朝向:" class="detail-label" style="width: 60px;" />
                            <ui:VisualElement name="prop-facing-container" style="width: 111px;" />
                            <ui:VisualElement class="flex-space" />
                            <ui:Button text="删除" name="btn-delete-object" class="small-btn danger-btn" />
                            <ui:Button text="发布" name="btn-publish" class="publish-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="item-element-mode-panel" class="mode-panel hidden" style="overflow: visible; visibility: visible; display: none;">
                <ui:VisualElement class="item-top-bar">
                    <ui:Label text="物品元件编辑模式" class="mode-title" />
                    <ui:VisualElement class="flex-space" />
                    <ui:Button text="添加元件" name="btn-add-item" class="tool-btn" />
                    <ui:Button text="导入配置" name="btn-import-config" class="tool-btn" />
                    <ui:Button text="导出配置" name="btn-export-config" class="tool-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="item-element-container">
                    <ui:VisualElement class="item-list-panel">
                        <ui:Label text="元件列表" class="sub-title" />
                        <!-- 元件类型Tab -->
                        <ui:VisualElement class="element-type-tabs">
                            <ui:Button text="建筑" name="item-tab-building" class="element-type-tab active" />
                            <ui:Button text="人物" name="item-tab-character" class="element-type-tab" />
                            <ui:Button text="物件" name="item-tab-prop" class="element-type-tab" />
                        </ui:VisualElement>
                        <ui:ScrollView name="item-list" class="item-list">
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="item-properties-panel">
                        <ui:Label text="元件属性" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="ID：" class="prop-label" />
                            <ui:TextField name="item-id-field" value="1001" class="prop-textfield" />
                            <ui:Label text="类型：" class="prop-label" />
                            <ui:VisualElement name="item-type-container" style="width: 120px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="模板名称：" class="prop-label" />
                            <ui:TextField name="item-name-field" value="钥匙" class="prop-textfield" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="Icon：" class="prop-label" />
                            <ui:TextField name="item-icon-field" value="item_key" class="prop-textfield" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="ResName：" class="prop-label" />
                            <ui:TextField name="item-resname-field" value="GameObject_Prop" class="prop-textfield" />
                        </ui:VisualElement>
                        <ui:Label text="动画设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="默认动画：" class="prop-label" />
                            <ui:TextField name="item-anim-field" value="Idle" class="prop-textfield" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="是否循环：" class="prop-label" />
                            <ui:Toggle name="item-loop-toggle" text="循环播放" value="true" />
                            <ui:Label text="播放速度：" class="prop-label" />
                            <ui:TextField name="item-speed-field" value="1.0" class="prop-textfield" style="width: 60px;" />
                        </ui:VisualElement>
                        <ui:Label text="交互设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="是否可交互：" class="prop-label" />
                            <ui:Toggle name="item-interactable-toggle" text="可交互" value="true" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="交互类型：" class="prop-label" />
                            <ui:VisualElement name="item-interact-type-container" style="width: 120px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="对话气泡：" class="prop-label" />
