                    <ui:Label name="status-mouse-x" text="0" class="status-value-fixed" />
                    <ui:Label text="mouseY:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-mouse-y" text="0" class="status-value-fixed" style="justify-content: flex-start;" />
                    <ui:Label text="tileX:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-x" text="0" class="status-value-fixed" />
                    <ui:Label text="tileY:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-y" text="0" class="status-value-fixed" />
                    <ui:Label text="格子数:" class="status-label" style="margin-left: 16px;" />
                    <ui:Label name="status-tile-count" text="0" class="status-value-fixed" />
                    <ui:Label text="保存路径:" class="status-label" style="margin-left: 16px;" />
                    <ui:Button name="status-save-path" text="Assets/GameData/MapDatas/" class="status-path-btn" style="width: 740px; flex-direction: row; justify-content: flex-start; -unity-text-align: middle-left; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;" />
                </ui:VisualElement>
                <ui:VisualElement class="bottom-props-area" style="height: 220px; padding: 6px; spacing: 8px; flex-direction: row; align-items: stretch; justify-content: flex-start;">
                    <ui:VisualElement name="VisualElement" class="prop-box" style="width: 380px; padding: 8px; spacing: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px;">
                        <ui:VisualElement class="prop-row" style="spacing: 8px; align-items: center; height: 26px;">
                            <ui:Button text="更新地图" class="small-btn" style="min-width: 80px; height: 22px;" />
