            <ui:VisualElement class="top-toolbar" style="flex-grow: 0; height: 30px;">
                <ui:VisualElement name="VisualElement" class="toolbar-row" style="flex-direction: row; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75); height: 30px;">
                    <ui:Button text="场景编辑" name="tab-scene" class="tab-btn active" style="width: 90px; height: 28px;" />
