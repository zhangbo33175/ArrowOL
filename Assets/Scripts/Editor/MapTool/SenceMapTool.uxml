    <ui:VisualElement class="root-container">
        <ui:VisualElement name="VisualElement" class="left-panel" style="width: 193px; background-color: rgb(79, 76, 76); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(87, 87, 96); border-right-color: rgb(87, 87, 96); border-top-color: rgb(87, 87, 96); border-bottom-color: rgb(87, 87, 96);">
