                            <ui:TextField name="item-sort-order-field" value="0" class="prop-textfield" style="width: 60px;" />
                            <ui:Label text="初始朝向：" class="prop-label" />
                            <ui:VisualElement name="item-facing-container" style="width: 80px;" />
