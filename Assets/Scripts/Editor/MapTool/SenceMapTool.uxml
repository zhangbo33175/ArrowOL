                            </ui:VisualElement>
                            <ui:Label text="Ctrl+左键 添加路径点（吸附32px网格）" class="shortcut-text" style="font-size: 10px;" />
                            <ui:ScrollView name="path-point-list" class="path-point-list" style="height: 80px; display: flex;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="anim-edit-content" class="obj-edit-content hidden" style="display: none;">
                            <ui:VisualElement class="obj-edit-info-row">
                                <ui:Label text="动画名称：" class="detail-label" />
                                <ui:TextField name="anim-name-field" value="Idle" class="prop-textfield flex-grow" style="width: 271px;" />
