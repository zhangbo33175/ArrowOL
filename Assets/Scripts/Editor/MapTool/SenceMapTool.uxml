                        <ui:VisualElement class="prop-row" style="spacing: 8px; align-items: center; height: 26px;">
                            <ui:Button text="导出切片" name="btn-export-slice" class="small-btn" style="min-width: 80px; height: 22px;" />
                            <ui:Label text="场景ID:" class="prop-label" style="width: 48px;" />
                            <ui:TextField value="1" name="scene-id-field" class="small-textfield flex-grow" />
                            <ui:Label text="高:" class="prop-label" style="width: 24px;" />
                            <ui:TextField value="4096" name="map-height-field" class="small-textfield" style="width: 60px;" />
