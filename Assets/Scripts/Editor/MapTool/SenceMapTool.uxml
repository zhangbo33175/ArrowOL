                                <ui:TextField name="anim-speed-field" value="1.0" class="prop-textfield" style="width: 50px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="property-panel" class="prop-box detail-box" style="flex-grow: 1; padding: 8px; spacing: 4px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75); margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
                        <ui:Label text="属性" class="box-title" style="margin-bottom: 2px;" />
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
