            </ui:VisualElement>
            <ui:VisualElement class="left-btn-row" style="border-top-width: 1px; border-bottom-width: 1px; -unity-slice-top: 0; -unity-slice-bottom: 5; border-right-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75);">
                <ui:Button text="建筑" name="tab-building" class="sub-tab-btn" />
