                            <ui:VisualElement name="prop-dialog-bubble-container" class="flex-grow" style="width: 111px;" />
                            <ui:Label text="气泡ID:" class="detail-label" style="width: 48px;" />
                            <ui:VisualElement name="prop-bubble-id-container" class="flex-grow" style="width: 80px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row" style="spacing: 6px; align-items: center;">
                            <ui:Label text="朝向:" class="detail-label" style="width: 60px;" />
                            <ui:VisualElement name="prop-facing-container" style="width: 111px;" />
                            <ui:VisualElement class="flex-space" />
                            <ui:Button text="删除" name="btn-delete-object" class="small-btn danger-btn" />
                            <ui:Button text="发布" name="btn-publish" class="publish-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="item-element-mode-panel" class="mode-panel hidden" style="overflow: visible; visibility: visible; display: none;">
