            <ui:VisualElement class="top-toolbar">
                <ui:VisualElement name="VisualElement" class="toolbar-row" style="flex-direction: row; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75);">
                    <ui:Button text="场景编辑" name="tab-scene" class="tab-btn active" style="width: 90px;" />
                    <ui:Button text="物品元件编辑" name="tab-item-element" class="tab-btn" style="width: 90px;" />
                    <ui:Button text="迷雾编辑" name="tab-fog" class="tab-btn" style="width: 90px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="scene-mode-panel" focusable="false" class="mode-panel" style="opacity: 1; display: flex; overflow: visible;">
                <ui:VisualElement name="VisualElement" class="toolbar-row" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgb(51, 51, 51); align-self: auto; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(70, 70, 75); border-right-color: rgb(70, 70, 75); border-top-color: rgb(70, 70, 75); border-bottom-color: rgb(70, 70, 75);">
                    <ui:Button text="导出设置" name="btn-export-settings" class="tool-btn" />
                    <ui:Button text="保存" name="btn-save" class="tool-btn" />
                    <ui:Button text="清空摆放物" name="btn-clear-objects" class="tool-btn danger-btn" />
                    <ui:Button text="清空格子数据" name="btn-clear-grid-data" class="tool-btn" />
                    <ui:VisualElement name="VisualElement" class="flex-space" style="width: 80px; max-width: 80px;" />
