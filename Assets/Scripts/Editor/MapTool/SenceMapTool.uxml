                        <ui:Label text="层级与碰撞" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="渲染层级：" class="prop-label" />
                            <ui:TextField name="item-sort-order-field" value="0" class="prop-textfield" style="width: 60px;" />
                            <ui:Label text="初始朝向：" class="prop-label" />
                            <ui:VisualElement name="item-facing-container" style="width: 80px;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="是否有碰撞：" class="prop-label" />
                            <ui:Toggle name="item-collision-toggle" text="启用碰撞" value="true" />
                            <ui:Label text="显示阴影：" class="prop-label" />
                            <ui:Toggle name="item-shadow-toggle" text="显示阴影" value="true" />
                        </ui:VisualElement>
                        <ui:Label text="收集物设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="是否收集物：" class="prop-label" />
                            <ui:Toggle name="item-collectible-toggle" text="可收集" />
                            <ui:Label text="重生时间：" class="prop-label" />
                            <ui:TextField name="item-respawn-field" value="0" class="prop-textfield" style="width: 60px;" />
                            <ui:Label text="秒" class="prop-label" />
                        </ui:VisualElement>
                        <ui:Label text="Y坐标深度排序" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="启用YSort：" class="prop-label" />
                            <ui:Toggle name="item-ysort-toggle" text="自动深度排序" value="true" />
                            <ui:Label text="偏移：" class="prop-label" />
                            <ui:TextField name="item-ysort-offset-field" value="0" class="prop-textfield" style="width: 60px;" />
                        </ui:VisualElement>
                        <ui:Label text="移动与循环" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="可移动：" class="prop-label" />
                            <ui:Toggle name="item-movable-toggle" text="允许移动" />
                            <ui:Label text="循环重启延迟：" class="prop-label" />
                            <ui:TextField name="item-loop-restart-field" value="3" class="prop-textfield" style="width: 60px;" />
                            <ui:Label text="秒" class="prop-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="离开地图隐藏：" class="prop-label" />
                            <ui:Toggle name="item-hide-offmap-toggle" text="自动隐藏" value="true" />
                        </ui:VisualElement>
                        <ui:Label text="传送门设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="是否传送门：" class="prop-label" />
                            <ui:Toggle name="item-teleport-toggle" text="启用传送门" />
                            <ui:Label text="目标场景：" class="prop-label" />
                            <ui:TextField name="item-teleport-scene-field" class="prop-textfield" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="目标X：" class="prop-label" />
                            <ui:TextField name="item-teleport-x-field" value="0" class="prop-textfield" style="width: 60px;" />
                            <ui:Label text="目标Y：" class="prop-label" />
                            <ui:TextField name="item-teleport-y-field" value="0" class="prop-textfield" style="width: 60px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="fog-mode-panel" class="mode-panel hidden" style="display: none;">
                <ui:VisualElement class="fog-top-bar">
                    <ui:Label text="迷雾编辑模式" class="mode-title" />
                    <ui:VisualElement class="flex-space" />
                    <ui:Button text="添加迷雾区域" name="btn-add-fog" class="tool-btn" />
                    <ui:Button text="清空迷雾" name="btn-clear-fog" class="tool-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="fog-container">
                    <ui:VisualElement class="fog-settings-panel">
                        <ui:Label text="笔刷设置" class="sub-title" />
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="笔刷大小：" class="prop-label" />
                            <ui:Slider low-value="10" high-value="200" value="100" class="prop-slider" />
                        </ui:VisualElement>
                        <ui:VisualElement class="prop-row">
                            <ui:Label text="迷雾透明度：" class="prop-label" />
                            <ui:Slider low-value="0" high-value="1" value="0.8" class="prop-slider" />
                        </ui:VisualElement>
                        <ui:Label text="绘制模式" class="sub-title" />
                        <ui:Button text="开始绘制" name="btn-start-draw" class="draw-mode-btn" />
                        <ui:Label text="快捷键：" class="sub-title" />
                        <ui:Label text="• 鼠标左键：绘制迷雾" class="shortcut-text" />
                        <ui:Label text="• 鼠标右键：擦除迷雾" class="shortcut-text" />
                        <ui:Label text="• 滚轮：缩放地图" name="Label" class="shortcut-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="fog-list-panel">
                        <ui:Label text="迷雾区域列表" class="sub-title" />
                        <ui:Label text="（暂无迷雾区域，点击「添加迷雾区域」或开始绘制）" class="empty-tip" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 资源整理面板 -->
            <ui:VisualElement name="resource-panel" class="mode-panel hidden" style="display: none; overflow: hidden;">
                <!-- 主内容区 -->
                <ui:VisualElement style="flex-direction: row; flex-grow: 1; overflow: hidden; padding: 8px;">
                    <!-- 左侧：未配置资源列表 -->
                    <ui:VisualElement style="width: 300px; min-width: 300px; margin-right: 12px; background: rgb(38, 38, 38); border-radius: 4px; border-width: 1px; border-color: rgb(70, 70, 75); padding: 8px;">
                        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                            <ui:Label text="未配置资源" style="font-size: 12px; color: rgb(200, 200, 200); -unity-font-style: bold; flex-grow: 1;" />
                            <ui:Button text="扫描" name="btn-scan-resources" class="tool-btn" style="width: 60px; height: 22px; font-size: 10px;" />
                        </ui:VisualElement>
                        <!-- 分类子 Tab -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;">
                            <ui:Button text="全部" name="tab-all" class="sub-tab-btn active" style="flex-grow: 1; height: 24px; font-size: 11px; margin-right: 2px;" />
                            <ui:Button text="背景" name="tab-bg" class="sub-tab-btn" style="flex-grow: 1; height: 24px; font-size: 11px; margin-right: 2px;" />
                            <ui:Button text="建筑" name="tab-building" class="sub-tab-btn" style="flex-grow: 1; height: 24px; font-size: 11px; margin-right: 2px;" />
                            <ui:Button text="人物" name="tab-char" class="sub-tab-btn" style="flex-grow: 1; height: 24px; font-size: 11px; margin-right: 2px;" />
                            <ui:Button text="物件" name="tab-prop" class="sub-tab-btn" style="flex-grow: 1; height: 24px; font-size: 11px; margin-right: 2px;" />
                            <ui:Button text="猫猫" name="tab-cat" class="sub-tab-btn" style="flex-grow: 1; height: 24px; font-size: 11px;" />
                        </ui:VisualElement>
                        <ui:ScrollView style="flex-grow: 1;">
                            <ui:VisualElement name="unconfigured-resources-list">
                                <ui:Label text="（点击「扫描」开始）" style="color: rgb(120, 120, 120); font-size: 11px; padding: 8px;" />
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <!-- 右侧：资源详情 -->
                    <ui:VisualElement style="flex-grow: 1; flex-direction: column; overflow: hidden;">
                        <!-- 预览图 + 基本信息 -->
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 8px;">
                            <!-- 预览图 -->
                            <ui:VisualElement style="width: 100px; margin-right: 12px;">
                                <ui:VisualElement name="resource-preview-container" style="background: rgb(42, 42, 42); height: 100px; align-items: center; justify-content: center; border-radius: 4px; border-width: 1px; border-color: rgb(70, 70, 75);">
                                    <ui:Label text="（预览图）" style="color: rgb(120, 120, 120); font-size: 11px;" />
                                </ui:VisualElement>
                                <ui:Label text="-" name="resource-detail-size" style="color: rgb(180, 180, 180); font-size: 11px; margin-top: 4px;" />
                            </ui:VisualElement>
                            <!-- 配置字段 -->
                            <ui:VisualElement style="flex-grow: 1; background: rgb(38, 38, 38); border-radius: 4px; border-width: 1px; border-color: rgb(70, 70, 75); padding: 8px;">
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 4px;">
                                    <ui:Label text="ID" style="width: 35px; color: rgb(180, 180, 180); font-size: 11px;" />
                                    <ui:TextField name="field-template-id" style="width: 120px;" value="template_0001" />
                                    <ui:Label text="ImagePath" style="width: 70px; color: rgb(180, 180, 180); font-size: 11px; margin-left: 12px;" />
                                    <ui:TextField name="field-image-path" style="flex-grow: 1;" value="-" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; margin-bottom: 4px;">
                                    <ui:Label text="Name" style="width: 35px; color: rgb(180, 180, 180); font-size: 11px;" />
                                    <ui:TextField name="field-template-name" style="flex-grow: 1;" value="-" />
                                    <ui:Label text="Anim" style="width: 35px; color: rgb(180, 180, 180); font-size: 11px; margin-left: 12px;" />
                                    <ui:TextField name="field-anim-name" style="width: 60px;" value="Idle" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; align-items: center;">
                                    <ui:Toggle text="Loop" name="field-loop" value="true" />
                                    <ui:Label text="Speed" style="width: 35px; color: rgb(180, 180, 180); font-size: 11px; margin-left: 8px;" />
                                    <ui:FloatField name="field-speed" style="width: 40px;" value="1" />
                                    <ui:Label text="Order" style="width: 35px; color: rgb(180, 180, 180); font-size: 11px; margin-left: 8px;" />
                                    <ui:IntegerField name="field-sort-order" style="width: 40px;" value="10" />
                                    <ui:Toggle text="Shadow" name="field-shadow" value="true" style="margin-left: 8px;" />
                                    <ui:Toggle text="Collectible" name="field-collectible" value="false" style="margin-left: 8px;" />
                                    <ui:VisualElement style="flex-grow: 1;" />
                                    <ui:Button text="添加到配置表" name="btn-add-to-config" class="tool-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- 配置表预览（Excel 样式） -->
                        <ui:VisualElement style="flex-grow: 1; background: rgb(30, 30, 30); border-radius: 4px; border-width: 1px; border-color: rgb(70, 70, 75); padding: 8px; overflow: hidden;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 6px;">
                                <ui:Label text="已配置资源列表" style="font-size: 12px; color: rgb(200, 200, 200); -unity-font-style: bold;" />
                                <ui:Label text="" name="current-config-name" style="font-size: 11px; color: rgb(150, 150, 150); margin-left: 8px;" />
                                <ui:VisualElement style="flex-grow: 1;" />
                                <ui:Button text="打开配置表" name="btn-open-config" class="tool-btn" style="width: 80px; height: 22px; font-size: 10px; margin-right: 4px;" />
                                <ui:Button text="打开文件位置" name="btn-open-folder" class="tool-btn" style="width: 90px; height: 22px; font-size: 10px; margin-right: 4px;" />
                                <ui:Button text="保存修改" name="btn-save-config" class="tool-btn" style="width: 80px; height: 22px; font-size: 10px;" />
                            </ui:VisualElement>
                            <!-- 表头（三行：英文列名、类型、中文说明） -->
                            <ui:VisualElement style="flex-direction: row; background-color: rgb(0, 0, 0); border-top-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); margin: 0; padding: 0;">
                                <ui:Label text="TemplateId" style="width: 80px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="ImagePath" style="width: 140px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="ResName" style="width: 150px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="TemplateName" style="width: 90px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="Loop" style="width: 80px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="Speed" style="width: 80px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="SortOrder" style="width: 120px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="DialogBubble" style="width: 120px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="IsCollectible" style="width: 90px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="RespawnTime" style="width: 100px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="操作" style="width: 56px; color: white; font-size: 11px; -unity-font-style: bold; margin: 0; padding-left: 6; padding-right: 6;" />
                            </ui:VisualElement>
                            <!-- 类型行 -->
                            <ui:VisualElement style="flex-direction: row; background-color: rgb(128, 128, 128); border-left-width: 1px; border-right-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0);">
                                <ui:Label text="int" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="string" style="width: 140px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="string" style="width: 150px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="string" style="width: 90px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="bool" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="float" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="int" style="width: 120px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="string" style="width: 120px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="bool" style="width: 90px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="float" style="width: 100px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="" style="width: 56px; color: white; font-size: 10px; padding-left: 6; padding-right: 6;" />
                            </ui:VisualElement>
                            <!-- 中文说明行 -->
                            <ui:VisualElement style="flex-direction: row; background-color: rgb(0, 176, 80); border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
                                <ui:Label text="序号" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="图片名称" style="width: 140px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="资源ResDef的名字" style="width: 150px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="物件名称" style="width: 90px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="是否循环播放" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="动画播放速度" style="width: 80px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="渲染层级排序(越大越靠前)" style="width: 120px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="对话气泡内容" style="width: 120px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="是否为收集物" style="width: 90px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="收集物重生时间(秒)" style="width: 100px; color: white; font-size: 10px; padding-left: 6; padding-right: 6; border-right-width: 1px; border-right-color: rgb(0, 0, 0);" />
                                <ui:Label text="" style="width: 56px; color: white; font-size: 10px; padding-left: 6; padding-right: 6;" />
                            </ui:VisualElement>
                            <!-- 数据列表（可滚动） -->
                            <ui:ScrollView style="flex-grow: 1; border-radius: 0 0 3px 3px;">
                                <ui:VisualElement name="config-list-container" class="config-table">
                                    <ui:Label text="（暂无配置数据）" style="color: rgb(120, 120, 120); font-size: 11px; padding: 8px;" />
                                </ui:VisualElement>
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
