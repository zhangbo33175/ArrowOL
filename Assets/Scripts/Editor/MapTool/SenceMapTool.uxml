                        <ui:Label text="Ctrl：按住=绘制矩形区域    松开=绘制菱形区域" class="shortcut-text" style="font-size: 10px; margin-top: 4px;" />
                        <ui:Label text="Alt：按住=擦除格子模式   Shift：按住曲线绘制区域" class="shortcut-text" style="font-size: 10px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="object-edit-panel" class="prop-box object-edit-panel" style="width: 360px; padding: 8px; spacing: 4px;">
                        <ui:Label name="obj-edit-title" text="对象编辑：未选择" class="obj-edit-title" style="margin-bottom: 4px; padding-bottom: 2px; border-bottom: 1px solid rgb(70, 70, 73);" />
                        <ui:VisualElement class="obj-edit-tab-row">
