<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Editor/MapTool/SenceMapTool.uss?fileID=7433441132597879392&amp;guid=dee590b43f3ab294288e062fa413558f&amp;type=3#SenceMapTool" />
    <ui:VisualElement class="root-container">
        <ui:VisualElement name="VisualElement" class="left-panel" style="width: 193px; background-color: rgb(79, 76, 76); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(87, 87, 96); border-right-color: rgb(87, 87, 96); border-top-color: rgb(87, 87, 96); border-bottom-color: rgb(87, 87, 96);">
