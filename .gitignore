# ============================================================
# Unity 项目 .gitignore（Honor）
# 说明：忽略 Unity / IDE 自动生成的目录与文件，仅提交真实工程内容。
# ============================================================

# ---- Unity 自动生成目录（根目录级，兼容大小写变体） ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/UIElementsSchema/

# ---- IDE 缓存目录 ----
/.idea/
/.vs/
/.vscode/

# ---- 解决方案 / 工程文件（由 Unity 与编辑器自动生成） ----
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
*.DotSettings
*.DotSettings.user

# ---- Unity 崩溃转储 ----
sysinfo.txt
*.stackdump

# ---- 构建产生的 PDB / MDB 的 meta（与源码 .meta 区分开，源码 .meta 必须提交） ----
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---- 操作系统 ----
.DS_Store
Thumbs.db
